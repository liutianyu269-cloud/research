+"use client";
+
+import { useEffect, useRef } from "react";
+import VisualDiagram from "@horsecoder/visual-core";
+import type { VisualCanvasConfig, VisualDiagramHandle, VisualElementProps } from "@horsecoder/visual-core";
+import styles from "./lab.module.css";
+
+export type Node = { id: string; label: string; detail: string };
+
+function StepElement({ element, pendant }: VisualElementProps) {
+  const subtitle = pendant?.data.detail.subtitle as string | undefined;
+  return (
+    <div className={styles.canvasNode}>
+      <strong>{element.state.name}</strong>
+      {subtitle && <span>{subtitle}</span>}
+    </div>
+  );
+}
+
+const config: VisualCanvasConfig = {
+  elementConfig: { components: { step: { component: StepElement, minSize: { width: 248, height: 56 } } } },
+  linkConfig: { components: { next: { hasArrow: true, showName: false } } },
+  toolbarConfig: [],
+  globalConfig: { gridSize: 20 },
+};
+
+export default function WorkflowCanvas({ nodes }: { nodes: Node[] }) {
+  const canvas = useRef<VisualDiagramHandle>(null);
+  const viewport = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    const container = viewport.current;
+    if (!container) return;
+    function renderWorkflow() {
+      const x = Math.max(12, Math.round(((container?.clientWidth ?? 248) - 248) / 2));
+      const elements = nodes.map((node, index) => ({
+        id: node.id, name: node.label, type: "step", color: "#0f766e",
+        x, y: 23 + index * 82, select: false, locked: true,
+        pendant: { data: { type: "step", detail: { subtitle: node.detail } }, onDataChange: () => {} },
+      }));
+      const links = elements.slice(1).map((node, index) => ({
+        id: "link-" + node.id, name: "传递产物", type: "next", color: "#0f766e",
+        fromElementId: elements[index].id, toElementId: node.id, points: [],
+      }));
+      canvas.current?.setView({ id: "liutianyu-manual-skill-lab", elements, links });
+    }
+    renderWorkflow();
+    const observer = new ResizeObserver(renderWorkflow);
+    observer.observe(container);
+    return () => observer.disconnect();
+  }, [nodes]);
+
+  return (
+    <div ref={viewport} className={styles.canvas} aria-label="课程编排画布">
+      <VisualDiagram ref={canvas} canvasConfig={config} />
+    </div>
+  );
+}
