+{
+  "cases": [
+    {
+      "id": "Eparse_gtb01",
+      "title": "复核工作簿与报告布局",
+      "method": "按文件和工作表遍历，保留表头与原值。",
+      "skill": "reporting-excel-tables-with-eparse",
+      "source": "https://github.com/ChrisPappalardo/eparse",
+      "upstreamCase": "Eparse_01",
+      "oldScore": 0.0,
+      "noSkillScore": 1.0,
+      "oldProblem": "Output text does not match reference text after normalization",
+      "oldStatus": "completed",
+      "conflict": null,
+      "output": "eparse_report.txt"
+    },
+    {
+      "id": "Eparse_gtb02",
+      "title": "逐单元格写出 JSON Lines",
+      "method": "从 Eparse 按行提取单元格记录；将格式争议留在评分侧。",
+      "skill": "serializing-eparse-cells-to-jsonl",
+      "source": "https://github.com/ChrisPappalardo/eparse",
+      "upstreamCase": "Eparse_02",
+      "oldScore": 0.0,
+      "noSkillScore": 0.0,
+      "oldProblem": "Invalid JSON: Extra data: line 2 column 1 (char 174)",
+      "oldStatus": "completed",
+      "conflict": "原题要求逐行 JSON，旧评分器整文件调用 json.loads。",
+      "output": "eparse_cells.jsonl"
+    },
+    {
+      "id": "MoviePy_gen01",
+      "title": "等比缩放与居中补边",
+      "method": "按短边适配画布，保持帧率和画幅，编码 H.264。",
