+"use client";
+
+import dynamic from "next/dynamic";
+import { useEffect, useMemo, useState } from "react";
+import type { Node } from "./workflow-canvas";
+import recorded from "./recorded.json";
+import styles from "./lab.module.css";
+
+const Canvas = dynamic(() => import("./workflow-canvas"), { ssr: false });
+const endpoint = (process.env.NEXT_PUBLIC_LTY_SKILL_BACKEND ?? "http://127.0.0.1:33479") + "/api/engine/flow";
+const flowId = "@com.horsecoder.skilllab.liutianyu/MANUAL_SKILL_LAB";
+
+type Case = {
+  id: string;
+  title: string;
+  method: string;
+  skill: string;
+  source: string;
+  upstreamCase: string | null;
+  oldScore: number | null;
+  noSkillScore: number | null;
+  oldProblem: string;
+  conflict: string | null;
+  output: string;
+};
+
+type Run = {
+  id: string;
+  stepsDone: string[];
+  status: string;
+  message: string | null;
+  artifact: { name: string; bytes: number; sha256: string } | null;
+  skill: { body: string; sha256: string };
+  validation: { passed: boolean; message: string } | null;
+  score: { value: number | null; comment: string | null; status: string } | null;
+};
+
+type Snapshot = { cases: Case[]; loaded: string[]; latest: Record<string, Run> };
+type Action = "list" | "register" | "unload" | "run";
+
+async function request(action: Action, task?: string, steps?: string[]) {
+  const response = await fetch(endpoint, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ flowId, params: { structure: JSON.stringify({ action, task, steps }) } }),
+  });
+  const payload = await response.json();
+  if (!response.ok || !payload.ok) {
+    throw new Error(payload.error ?? "课程后端请求失败");
+  }
+  return payload.data as Snapshot;
+}
+
+function scoreText(value: number | null | undefined) {
+  if (value == null) return "未评分";
+  return Number.isInteger(value) ? String(value) : value.toFixed(2);
+}
+
+export default function ManualSkillLab() {
+  const [data, setData] = useState<Snapshot>(recorded as Snapshot);
+  const [active, setActive] = useState("ScikitImage_gen06");
+  const [validate, setValidate] = useState(true);
+  const [grade, setGrade] = useState(true);
+  const [online, setOnline] = useState(false);
+  const [pending, setPending] = useState<Action | null>("list");
+  const [message, setMessage] = useState("");
+  const selected = data.cases.find((item) => item.id === active) ?? data.cases[0];
+  const current = data.latest[selected.id];
+  const registered = data.loaded.includes(selected.id);
+  const recordedRuns = Object.values(data.latest);
+  const passes = recordedRuns.filter((run) => run.score?.value === 1).length;
+
+  const nodes = useMemo<Node[]>(() => [
+    { id: "read", label: "读取原始输入", detail: selected.id },
+    { id: "execute", label: selected.title, detail: "调用已注册的 Skill" },
+    ...(validate ? [{ id: "validate", label: "校验任务产物", detail: selected.output }] : []),
+    ...(grade ? [{ id: "grade", label: "原评分器复评", detail: "记录原生结果与错误" }] : []),
+  ], [selected, validate, grade]);
+
+  useEffect(() => {
+    let activeRequest = true;
+    request("list").then((snapshot) => {
+      if (activeRequest) {
+        setData(snapshot);
+        setOnline(true);
+      }
+    }).catch(() => {
+      if (activeRequest) setMessage("课程后端未连接，当前显示已保存的原题记录。");
+    }).finally(() => {
+      if (activeRequest) setPending(null);
+    });
+    return () => { activeRequest = false; };
+  }, []);
+
+  async function operate(action: Action) {
+    setPending(action);
+    setMessage("");
+    try {
+      const result = await request(action, selected.id, nodes.map((node) => node.id));
+      setData((prior) => ({ ...prior, ...result }));
+      setOnline(true);
+    } catch (error) {
+      setMessage(error instanceof Error ? error.message : "执行失败");
+    } finally {
+      setPending(null);
+    }
+  }
+
+  function exportCurrent() {
+    const contents = JSON.stringify({ case: selected, run: current }, null, 2);
+    const url = URL.createObjectURL(new Blob([contents], { type: "application/json" }));
+    const anchor = document.createElement("a");
+    anchor.href = url;
+    anchor.download = selected.id + "-复评记录.json";
+    anchor.click();
+    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }
+
+  return (
+    <main className={styles.app}>
+      <header className={styles.header}>
+        <div className={styles.brand}>
+          <span className={styles.mark} aria-hidden="true">S</span>
+          <span>Skill 工作台</span>
+          <span className={styles.divider} />
+          <span className={styles.crumb}>刘添予 / 人工编排</span>
+        </div>
+        <div className={styles.headerRight}>
+          <span className={styles.connection} data-online={online}><i />{online ? "已连接课程后端" : "本地记录"}</span>
+          <button className={styles.headerButton} onClick={() => void operate("list")} disabled={pending != null}>刷新连接</button>
+        </div>
+      </header>
+      <div className={styles.shell}>
+        <div className={styles.heading}>
+          <div>
+            <p className={styles.kicker}>SkillGenBench</p>
+            <h1>原题修复工作台</h1>
+            <p className={styles.subtitle}>从仓库提炼 Skill，手工编排运行步骤，用原输入和原评分器复评。</p>
+          </div>
+          <dl className={styles.metrics}>
+            <div><dt>历史原题</dt><dd>{data.cases.length}</dd></div>
+            <div><dt>生成产物</dt><dd>{recordedRuns.filter((run) => run.artifact).length}</dd></div>
+            <div><dt>本轮原判通过</dt><dd>{passes}</dd></div>
+          </dl>
+        </div>
+        {message && <p role="status" className={styles.notice}>{message}</p>}
+        <div className={styles.grid}>
+          <aside className={styles.sidebar} aria-label="历史题目">
+            <div className={styles.panelTitle}><h2>历史题目</h2><span>{data.cases.length} 道</span></div>
+            <div className={styles.caseList}>
+              {data.cases.map((item) => {
+                const latest = data.latest[item.id];
+                let state = "待复评";
+                if (item.conflict) state = "评测冲突";
+                else if (latest?.score?.value === 1) state = "已通过";
+                else if (latest?.score?.value === 0) state = "原判未过";
+                else if (latest?.artifact) state = "已产出";
+                return (
+                  <button key={item.id} aria-current={item.id === selected.id} className={styles.case}
+                    onClick={() => setActive(item.id)} disabled={pending != null}>
+                    <span className={styles.caseMain}><code>{item.id}</code><span>{item.title}</span></span>
+                    <small data-kind={state}>{state}</small>
+                  </button>
+                );
+              })}
+            </div>
+          </aside>
+          <section className={styles.center} aria-label="人工编排">
+            <div className={styles.caseHeading}>
+              <div><code>{selected.id}</code><h2>{selected.title}</h2></div>
+              <span className={styles.skillState} data-loaded={registered}>{registered ? "Skill 已注册" : "Skill 未加载"}</span>
+            </div>
+            <div className={styles.controls}>
+              <label><input type="checkbox" checked={validate} onChange={(event) => setValidate(event.target.checked)} />校验产物</label>
+              <label><input type="checkbox" checked={grade} onChange={(event) => setGrade(event.target.checked)} />原题复评</label>
+            </div>
+            <Canvas nodes={nodes} />
+            <ol className={styles.stageList} aria-label="执行清单">
+              {nodes.map((node, index) => <li key={node.id}><span>{index + 1}</span>{node.label}</li>)}
+            </ol>
+            <div className={styles.footer}>
+              <button className={styles.secondary} onClick={() => void operate(registered ? "unload" : "register")}
+                disabled={!online || pending != null}>{registered ? "卸载 Skill" : "注册 Skill"}</button>
+              <button className={styles.primary} onClick={() => void operate("run")}
+                disabled={!online || !registered || pending != null}>{pending === "run" ? "正在执行…" : "运行选中流程"}</button>
+            </div>
+          </section>
+          <aside className={styles.inspector} aria-label="结果与证据">
+            <div className={styles.panelTitle}><h2>结果与证据</h2></div>
+            <div className={styles.evidenceBlock}>
+              <h3>原失败记录</h3>
+              <p>{selected.oldProblem}</p>
+              {selected.conflict && <p className={styles.conflict}>{selected.conflict}</p>}
+              <dl className={styles.scores}>
+                <div><dt>无 Skill 基线</dt><dd>{scoreText(selected.noSkillScore)}</dd></div>
+                <div><dt>旧有 Skill</dt><dd>{scoreText(selected.oldScore)}</dd></div>
+                <div><dt>本轮原判</dt><dd>{scoreText(current?.score?.value)}</dd></div>
+              </dl>
+            </div>
+            <div className={styles.evidenceBlock}>
+              <h3>从仓库抽取的做法</h3>
+              <p>{selected.method}</p>
+              <a href={selected.source} target="_blank" rel="noreferrer">查看代码仓库 ↗</a>
+              {selected.upstreamCase && <p className={styles.upstream}>关联 GitTaskBench 题 <code>{selected.upstreamCase}</code></p>}
+            </div>
+            <div className={styles.evidenceBlock}>
+              <h3>本次执行记录</h3>
+              {current?.validation && <p><strong>{current.validation.passed ? "产物校验通过" : "产物校验失败"}</strong> {current.validation.message}</p>}
+              <p>{current?.score?.comment ?? current?.message ?? (current ? "本次流程未运行原评分器。" : "等待执行。")}</p>
+              {current?.artifact && (
+                <div className={styles.artifact}>
+                  <code>{current.artifact.name}</code>
+                  <small>{new Intl.NumberFormat("zh-CN").format(current.artifact.bytes)} 字节</small>
+                </div>
+              )}
+              {current && <button className={styles.secondary} onClick={exportCurrent}>导出复评记录</button>}
+            </div>
+          </aside>
+        </div>
+      </div>
+    </main>
+  );
+}
diff --git a/app/liutianyu-skill-lab/page.tsx b/app/liutianyu-skill-lab/page.tsx
