+.app {
+  --ink: #172733;
+  --muted: #546572;
+  --line: #dbe4e6;
+  --accent: #076c63;
+  min-height: 100vh;
+  background: #f0f4f5;
+  color: var(--ink);
+  font-family: "Geist", "Microsoft YaHei", "PingFang SC", sans-serif;
+}
+
+.header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 18px;
+  min-height: 66px;
+  padding: 10px max(28px, calc((100vw - 1510px) / 2));
+  color: #eef6f6;
+  background: #132b35;
+}
+
+.brand, .headerRight, .connection { display: flex; align-items: center; gap: 13px; }
+.brand { font-size: 15px; font-weight: 650; white-space: nowrap; }
+.mark { display: grid; place-items: center; border-radius: 9px; width: 32px; height: 32px; background: #abf2dc; color: #0c453d; font-size: 19px; }
+.divider { width: 1px; height: 20px; background: #45606a; }
+.crumb, .connection { color: #bfd0d5; font-size: 12px; font-weight: 500; }
+.connection { gap: 7px; white-space: nowrap; }
+.connection i { width: 7px; height: 7px; border-radius: 50%; background: #d9ad70; }
+.connection[data-online=true] i { background: #7edfb8; }
+.headerButton { padding: 7px 10px; border: 1px solid #45606a; border-radius: 6px; color: #f1f6f7; white-space: nowrap; }
+
+.shell { width: min(1510px, 100% - 56px); margin: 0 auto; padding: 35px 0 40px; }
+.heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 26px; }
+.kicker { margin-bottom: 8px; color: var(--accent); font: 600 13px/1.4 "Geist Mono", Consolas, monospace; }
+.heading h1 { margin-bottom: 9px; font-size: clamp(27px, 3vw, 38px); font-weight: 700; line-height: 1.22; letter-spacing: -.045em; }
+.subtitle, .notice { color: var(--muted); font-size: 14px; line-height: 1.65; }
+.notice { padding: 11px 14px; margin: 0 0 18px; background: #fff4dc; border: 1px solid #f1deb7; border-radius: 7px; color: #785019; }
+.metrics { display: flex; flex-wrap: wrap; gap: 8px; }
+.metrics div { display: flex; gap: 14px; align-items: center; border: 1px solid var(--line); border-radius: 8px; background: #fff; padding: 8px 13px; }
+.metrics dt { color: var(--muted); font-size: 12px; }
+.metrics dd { color: #14383c; font-size: 21px; font-weight: 700; font-variant-numeric: tabular-nums; }
+
+.grid { display: grid; grid-template-columns: minmax(235px, 0.8fr) minmax(0, 1.55fr) minmax(260px, .94fr); gap: 15px; align-items: start; }
+.sidebar, .center, .inspector { background: #fff; border: 1px solid var(--line); border-radius: 11px; min-width: 0; }
+.panelTitle { min-height: 53px; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 0 15px; border-bottom: 1px solid var(--line); }
+.panelTitle h2 { font-size: 15px; font-weight: 700; }
+.panelTitle span { color: var(--muted); font-size: 12px; }
+.caseList { display: grid; gap: 4px; padding: 7px; }
+.case { display: flex; min-height: 48px; text-align: left; align-items: center; justify-content: space-between; gap: 5px; padding: 6px 8px; border: 1px solid transparent; border-radius: 7px; }
+.case:hover { background: #f1f6f6; }
+.case[aria-current=true] { border-color: #addbd2; background: #e9f6f2; }
+.caseMain { display: grid; gap: 2px; text-align: left; min-width: 0; }
+.caseMain code { color: #24404a; font-size: 12px; font-weight: 650; overflow-wrap: anywhere; }
+.caseMain span { color: var(--muted); font-size: 11px; line-height: 1.35; }
+.case small, .skillState { flex: none; border-radius: 99px; color: #495d69; padding: 3px 6px; background: #edf1f3; font-size: 10px; white-space: nowrap; }
+.case small[data-kind=已通过], .skillState[data-loaded=true] { color: #086c56; background: #dff3ea; }
+.case small[data-kind=评测冲突] { color: #85541b; background: #fff0d6; }
+.case small[data-kind=原判未过] { color: #823a35; background: #f9ebe8; }
+
+.caseHeading { display: flex; gap: 12px; justify-content: space-between; align-items: center; padding: 17px 18px 14px; min-height: 81px; }
+.caseHeading code { color: var(--accent); font-size: 12px; }
+.caseHeading h2 { font-size: 20px; line-height: 1.27; font-weight: 700; margin-top: 4px; }
+.skillState { font-size: 11px; padding: 5px 9px; }
+.controls { display: flex; align-items: center; gap: 17px; padding: 0 18px 11px; }
+.controls label { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 12px; }
+.controls input { accent-color: var(--accent); width: 14px; height: 14px; }
+.canvas { height: 343px; position: relative; overflow: hidden; background: #f5f9f8; border-block: 1px solid var(--line); isolation: isolate; }
+.canvas > div { width: 100%; height: 100%; }
+.canvasNode { height: 55px; display: grid; align-content: center; gap: 2px; padding: 4px 9px; line-height: 1.35; color: #173e43; }
+.canvasNode strong { font-size: 13px; }
+.canvasNode span { font-size: 11px; color: #537073; }
+.stageList { display: flex; flex-wrap: wrap; gap: 7px; list-style: none; padding: 11px 14px; color: #465965; font-size: 11px; }
+.stageList li { display: flex; align-items: center; gap: 5px; background: #edf4f3; border-radius: 4px; padding: 4px 5px; }
+.stageList li span { color: var(--accent); font-variant-numeric: tabular-nums; font-weight: 700; }
+.footer { display: flex; justify-content: end; flex-wrap: wrap; gap: 8px; padding: 10px 15px 15px; }
+.primary, .secondary { border: 1px solid #bccdce; border-radius: 6px; padding: 7px 10px; color: #163c40; font-size: 12px; font-weight: 650; }
+.primary { color: #fff; background: var(--accent); border-color: var(--accent); }
+.primary:hover { background: #095950; }
+.secondary:hover { background: #ecf5f3; }
+.app button:disabled { opacity: .57; cursor: not-allowed; }
+.app button:focus-visible, .app a:focus-visible, .app input:focus-visible { outline: 2px solid #108b7c; outline-offset: 3px; }
+
+.evidenceBlock { display: grid; align-content: start; gap: 7px; padding: 14px 15px; border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }
+.evidenceBlock:last-child { border-bottom: 0; }
+.evidenceBlock h3 { font-size: 13px; font-weight: 700; }
+.evidenceBlock p, .evidenceBlock a { font-size: 12px; line-height: 1.6; }
+.evidenceBlock p { color: var(--muted); }
+.evidenceBlock a { color: var(--accent); width: fit-content; text-decoration: underline; text-underline-offset: 2px; }
+.evidenceBlock .conflict { border-left: 3px solid #d6ac5e; background: #fff6e2; padding: 6px 8px; color: #755025; }
+.evidenceBlock .upstream { color: #426166; }
+.scores { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 4px; border-block: 1px solid var(--line); padding: 8px 0; }
+.scores dt { color: var(--muted); font-size: 10px; }
+.scores dd { font-weight: 650; font-size: 15px; font-variant-numeric: tabular-nums; }
+.artifact { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: baseline; line-height: 1.4; font-size: 11px; padding: 7px 8px; border: 1px solid var(--line); border-radius: 5px; }
+.artifact small { color: var(--muted); }
+.evidenceBlock > button { justify-self: start; }
+
+@media (max-width: 1070px) {
+  .shell { width: calc(100% - 36px); }
+  .heading { align-items: start; flex-direction: column; }
+  .grid { grid-template-columns: minmax(215px,.73fr) minmax(0,1.6fr); }
+  .inspector { grid-column: 2; }
+}
+@media (max-width: 675px) {
+  .header { flex-wrap: wrap; padding: 9px 12px; gap: 9px; }
+  .shell { width: calc(100% - 24px); padding-top: 25px; }
+  .grid { grid-template-columns: minmax(0,1fr); }
+  .inspector { grid-column: 1; }
+  .caseList { grid-template-columns: repeat(2,minmax(0,1fr)); }
+  .canvas { height: 343px; }
+}
+@media (max-width: 430px) {
+  .caseList { grid-template-columns: 1fr; }
+  .metrics div { gap: 6px; padding: 5px 8px; }
+  .metrics dd { font-size: 17px; }
+}
