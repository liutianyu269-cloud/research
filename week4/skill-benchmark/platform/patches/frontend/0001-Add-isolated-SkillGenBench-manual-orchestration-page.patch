+import type { Metadata } from "next";
+import ManualSkillLab from "./lab";
+
+export const metadata: Metadata = {
+  title: "SkillGenBench 人工编排 · 刘添予",
+  description: "课程 Skill 工作流的原题执行和复评",
+};
+
+export default function Page() {
+  return <ManualSkillLab />;
+}
