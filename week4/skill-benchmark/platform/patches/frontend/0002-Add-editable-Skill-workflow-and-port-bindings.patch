diff --git a/app/liutianyu-skill-lab/workflow/workbench.tsx b/app/liutianyu-skill-lab/workflow/workbench.tsx
new file mode 100644
index 0000000..74af0a7
--- /dev/null
+++ b/app/liutianyu-skill-lab/workflow/workbench.tsx
@@ -0,0 +1,365 @@
+"use client";
+
+import Link from "next/link";
+import { useEffect, useState } from "react";
+import styles from "./workbench.module.css";
+
+const api = (process.env.NEXT_PUBLIC_LTY_WORKFLOW_BACKEND ?? process.env.NEXT_PUBLIC_LTY_SKILL_BACKEND ?? "http://127.0.0.1:33479") + "/api/skill-lab/v2";
+const savedKey = "liutianyu-skill-lab-v2-workflow";
+const datasetLabels: Record<string, string> = { skillgenbench: "SkillGenBench", gittaskbench: "GitTaskBench" };
+const blank: Workflow = { dataset: "", caseId: "", nodes: [] };
+
+type Skill = {
+  id: string; title: string; description: string | null; source: string | null;
+  script: string | null; skillFile: string | null; inputType: string; outputType: string;
+};
+type Fixture = { id: string; title: string; inputRoot: string; expectedOutput: string; skillId: string; outputType?: string };
+type Dataset = { dataset: string; cases: Fixture[]; skills: Skill[] };
+type Registration = { loaded: boolean; generation: number; flowId: string; session: string };
+type Catalog = { datasets: Dataset[]; skills: Skill[]; registrations: Record<string, Registration> };
+type Binding = { from: "case"; port: "fixtures" } | { from: "node"; nodeId: string; port: "artifact" };
+type Node = { id: string; skillId: string; input: Binding | null };
+type Workflow = { dataset: string; caseId: string; nodes: Node[] };
+type Artifact = { path: string; bytes: number; sha256: string };
+type NodeTrace = {
+  id: string; skillId: string; status: "passed" | "failed"; elapsedMs: number;
+  inputDirectory: string; outputDirectory: string | null; outputType: string;
+  flowId: string | null; generation: number;
+  artifacts: Artifact[]; error: string | null;
+};
+type Run = { id: string; status: "passed" | "failed"; directory: string; nodes: NodeTrace[] };
+type Action = "register" | "revoke" | "reload";
+type Port = { key: string; label: string; type: string; binding: Binding };
+
+const actionLabels: Record<Action, string> = { register: "注册并装配", revoke: "撤销", reload: "重载" };
+
+async function request<T>(path: string, method = "GET", data?: object): Promise<T> {
+  const response = await fetch(api + path, {
+    method,
+    cache: "no-store",
+    headers: data ? { "Content-Type": "application/json" } : undefined,
+    body: data ? JSON.stringify(data) : undefined,
+  });
+  const body = await response.json();
+  if (!response.ok) throw new Error(body.error ?? "课程后端请求失败");
+  return body as T;
+}
+
+function matchingPort(node: Node, ports: Port[]) {
+  const binding = node.input;
+  const key = binding?.from === "node" ? binding.nodeId : binding?.from === "case" ? "fixtures" : "";
+  return ports.find((port) => port.key === key);
+}
+
+function compatible(skill: Skill, port: Port) {
+  return skill.inputType === port.type || (skill.inputType === "*" && port.binding.from === "node");
+}
+
+function restoreWorkflow(catalog: Catalog): Workflow {
+  const fallback = { dataset: catalog.datasets[0]?.dataset ?? "", caseId: catalog.datasets[0]?.cases[0]?.id ?? "", nodes: [] };
+  try {
+    const stored = window.localStorage.getItem(savedKey);
+    if (!stored) return fallback;
+    const draft = JSON.parse(stored) as Workflow;
+    const dataset = catalog.datasets.find((item) => item.dataset === draft.dataset);
+    if (dataset?.cases.some((item) => item.id === draft.caseId) && Array.isArray(draft.nodes) &&
+        draft.nodes.length <= 10 && draft.nodes.every((node) => typeof node.id === "string" &&
+          catalog.skills.some((skill) => skill.id === node.skillId))) {
+      return draft;
+    }
+  } catch {
+    return fallback;
+  }
+  return fallback;
+}
+
+function errorText(error: unknown) {
+  return error instanceof Error ? error.message : "课程后端请求失败";
+}
+
+export default function WorkflowWorkbench() {
+  const [catalog, setCatalog] = useState<Catalog | null>(null);
+  const [workflow, setWorkflow] = useState<Workflow>(blank);
+  const [run, setRun] = useState<Run | null>(null);
+  const [busy, setBusy] = useState("catalog");
+  const [notice, setNotice] = useState("");
+  const [fault, setFault] = useState("");
+  const dataset = catalog?.datasets.find((item) => item.dataset === workflow.dataset);
+  const fixture = dataset?.cases.find((item) => item.id === workflow.caseId);
+  const inputSkill = catalog?.skills.find((item) => item.id === fixture?.skillId);
+  const visibleSkills = [...(dataset?.skills ?? []), ...(catalog?.skills.filter((skill) => !skill.script) ?? [])];
+  const ports: Port[] = inputSkill
+    ? [{ key: "fixtures", label: "场景输入 · fixtures", type: inputSkill.inputType, binding: { from: "case", port: "fixtures" } }]
+    : [];
+  const nodeViews = workflow.nodes.map((node, index) => {
+    const skill = catalog?.skills.find((item) => item.id === node.skillId);
+    const available = skill ? ports.filter((port) => compatible(skill, port)) : [];
+    const binding = matchingPort(node, available);
+    const declaredOutput = fixture && fixture.skillId === skill?.id && fixture.outputType
+      ? fixture.outputType : skill?.outputType;
+    const output = declaredOutput === "$input" ? binding?.type : declaredOutput;
+    if (binding && output) {
+      ports.push({ key: node.id, label: String(index + 1) + ". " + skill?.title + " · artifact", type: output,
+        binding: { from: "node", nodeId: node.id, port: "artifact" } });
+    }
+    return { node, skill, available, binding, output };
+  });
+  const ready = Boolean(fixture && nodeViews.length && nodeViews.every(({ node, binding }) => binding &&
+    catalog?.registrations[node.skillId]?.loaded));
+
+  useEffect(() => {
+    let active = true;
+    request<Catalog>("/catalog").then((value) => {
+      if (!active) return;
+      setCatalog(value);
+      setWorkflow(restoreWorkflow(value));
+    }).catch((error) => {
+      if (active) setFault(errorText(error));
+    }).finally(() => {
+      if (active) setBusy("");
+    });
+    return () => { active = false; };
+  }, []);
+
+  async function refresh() {
+    setBusy("catalog");
+    setFault("");
+    try {
+      const value = await request<Catalog>("/catalog");
+      setCatalog(value);
+      if (!value.datasets.some((item) => item.dataset === workflow.dataset)) {
+        setWorkflow(restoreWorkflow(value));
+      }
+    } catch (error) {
+      setFault(errorText(error));
+    } finally {
+      setBusy("");
+    }
+  }
+
+  function replaceWorkflow(next: Workflow) {
+    setWorkflow(next);
+    setRun(null);
+    setNotice("");
+    setFault("");
+  }
+
+  function changeDataset(id: string) {
+    const selected = catalog?.datasets.find((item) => item.dataset === id);
+    replaceWorkflow({ dataset: id, caseId: selected?.cases[0]?.id ?? "", nodes: [] });
+  }
+
+  function add(skillId: string) {
+    if (workflow.nodes.length >= 10) return;
+    const node = { id: "node-" + window.crypto.randomUUID(), skillId, input: null };
+    replaceWorkflow({ ...workflow, nodes: [...workflow.nodes, node] });
+  }
+
+  function move(index: number, offset: number) {
+    const nodes = [...workflow.nodes];
+    const [node] = nodes.splice(index, 1);
+    nodes.splice(index + offset, 0, node);
+    replaceWorkflow({ ...workflow, nodes });
+  }
+
+  function bind(nodeId: string, input: Binding | null) {
+    replaceWorkflow({ ...workflow, nodes: workflow.nodes.map((node) => node.id === nodeId ? { ...node, input } : node) });
+  }
+
+  async function registry(skill: Skill, action: Action) {
+    setBusy(skill.id);
+    setFault("");
+    setNotice("");
+    try {
+      const state = await request<Registration>("/registry/" + encodeURIComponent(skill.id), "PUT", { action });
+      setCatalog((previous) => previous && { ...previous, registrations: { ...previous.registrations, [skill.id]: state } });
+      setNotice(skill.title + " · " + actionLabels[action] + "完成");
+    } catch (error) {
+      setFault(errorText(error));
+    } finally {
+      setBusy("");
+    }
+  }
+
+  function save() {
+    setFault("");
+    try {
+      window.localStorage.setItem(savedKey, JSON.stringify(workflow));
+      setNotice("工作流已保存到当前浏览器。");
+    } catch (error) {
+      setFault(errorText(error));
+    }
+  }
+
+  function exportJson() {
+    const file = new Blob([JSON.stringify(workflow, null, 2)], { type: "application/json" });
+    const url = URL.createObjectURL(file);
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = workflow.caseId + "-workflow.json";
+    link.click();
+    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }
+
+  async function execute() {
+    setBusy("run");
+    setRun(null);
+    setFault("");
+    setNotice("");
+    try {
+      setRun(await request<Run>("/runs", "POST", workflow));
+    } catch (error) {
+      setFault(errorText(error));
+    } finally {
+      setBusy("");
+    }
+  }
+
+  return (
+    <main lang="zh-CN" className={styles.app}>
+      <header className={styles.bar}>
+        <div className={styles.barInner}>
+          <div className={styles.identity}><span aria-hidden="true">S</span> Skill 工作台 <small>刘添予</small></div>
+          <div className={styles.barActions}>
+            <Link href="/liutianyu-skill-lab">原题复评记录</Link>
+            <button type="button" onClick={() => void refresh()} disabled={Boolean(busy)}>刷新目录</button>
+          </div>
+        </div>
+      </header>
+      <div className={styles.shell}>
+        <section className={styles.heading} aria-labelledby="lab-title">
+          <div>
+            <h1 id="lab-title">人工编排</h1>
+            <p>选择场景，从目录装配 Skill，再按节点连接输入与产物。</p>
+          </div>
+          <span className={styles.connection} data-online={Boolean(catalog)}><i />{catalog ? "课程后端已连接" : "等待课程后端"}</span>
+        </section>
+        {fault && <p className={styles.error} role="alert">{fault}</p>}
+        {notice && <p className={styles.notice} role="status">{notice}</p>}
+        {busy === "catalog" && <p role="status" className={styles.notice}>正在读取课程目录…</p>}
+        {catalog && !catalog.datasets.length && <p className={styles.notice}>课程工作区还没有已发布的回归目录。</p>}
+        <section className={styles.scenario} aria-label="场景输入">
+          <div>
+            <label htmlFor="lab-dataset">数据集</label>
+            <select id="lab-dataset" disabled={!catalog?.datasets.length || Boolean(busy)} value={workflow.dataset}
+              onChange={(event) => changeDataset(event.target.value)}>
+              {!catalog?.datasets.length && <option value="">等待目录</option>}
+              {catalog?.datasets.map((item) => <option key={item.dataset} value={item.dataset}>{datasetLabels[item.dataset] ?? item.dataset}</option>)}
+            </select>
+          </div>
+          <div>
+            <label htmlFor="lab-case">回归场景</label>
+            <select id="lab-case" disabled={!dataset?.cases.length || Boolean(busy)} value={workflow.caseId}
+              onChange={(event) => replaceWorkflow({ ...workflow, caseId: event.target.value })}>
+              {!dataset?.cases.length && <option value="">等待场景</option>}
