+    static final class Execution {
+        private static final Logger log = LoggerFactory.getLogger(Execution.class);
+        final Plan plan;
+        final Run run = new Run();
+        private final Path fixtures;
+        private final Path directory;
+        private final Map<String, Path> completed = new LinkedHashMap<>();
+
+        Execution(String flowId, Plan plan) throws IOException {
+            this.plan = plan;
+            fixtures = SkillLabV2Catalog.inside(plan.root, plan.fixture.inputRoot);
+            if (!Files.isDirectory(fixtures)) {
+                throw new IllegalArgumentException("场景输入应为目录");
+            }
+            Path runs = plan.root.resolve("work/skill-lab-v2/platform/runs");
+            Files.createDirectories(runs);
+            if (!runs.toRealPath().startsWith(plan.root)) {
+                throw new IOException("运行目录位于课程工作区之外");
+            }
+            run.id = UUID.randomUUID().toString();
+            run.flowId = flowId;
+            run.workflow = plan.workflow;
+            run.status = "passed";
+            directory = Files.createDirectory(runs.resolve(run.id));
+            run.directory = displayPath(directory);
+        }
+
+        boolean finished() {
+            return "failed".equals(run.status) || run.nodes.size() == plan.workflow.nodes.size();
+        }
+
+        void execute(String nodeId, SkillLabV2Engine.Registration registration,
+                SkillLabV2Runner runner) throws IOException {
+            Node node = plan.workflow.nodes.get(run.nodes.size());
+            if (!node.id.equals(nodeId)) {
+                throw new IllegalStateException("原生路由与注册顺序不一致 " + nodeId);
+            }
+            Path source = "case".equals(node.input.from) ? fixtures : completed.get(node.input.nodeId);
+            NodeResult trace = new NodeResult();
+            trace.id = node.id;
+            trace.skillId = node.skillId;
+            trace.inputDirectory = displayPath(source);
+            trace.outputType = plan.outputTypes.get(node.id);
+            trace.flowId = registration.flowId;
+            trace.generation = registration.generation;
+            long started = System.nanoTime();
+            try {
+                if (!registration.loaded) {
+                    throw new IllegalStateException("Skill 已撤销或尚未装配 " + node.skillId);
+                }
+                Path step = Files.createDirectory(directory.resolve(node.id));
+                Invocation invocation = new Invocation();
+                invocation.skillId = node.skillId;
+                invocation.argument = plan.fixture.skillArgument;
+                invocation.expected = plan.fixture.expectedOutput;
+                invocation.script = plan.scripts.get(node.id);
+                invocation.input = source.toString();
+                invocation.output = step.resolve("output").toString();
+                Result result = runner.execute(invocation);
+                trace.error = result.error;
+                if (result.error == null) {
+                    Path produced = Paths.get(result.directory);
+                    completed.put(node.id, produced);
+                    trace.outputDirectory = displayPath(produced);
+                    trace.artifacts = result.artifacts;
+                }
+            } catch (Exception error) {
+                log.warn("Skill node {} failed", node.id, error);
+                trace.error = error.getMessage() == null ? error.getClass().getSimpleName() : error.getMessage();
+            }
+            trace.elapsedMs = (System.nanoTime() - started) / 1_000_000;
+            trace.status = trace.error == null ? "passed" : "failed";
+            run.nodes.add(trace);
+            if (trace.error != null) {
+                run.status = "failed";
+            }
+        }
+
+        void save(ObjectMapper json) throws IOException {
