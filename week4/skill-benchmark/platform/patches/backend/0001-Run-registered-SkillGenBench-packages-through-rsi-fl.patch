+"""Run video and image skills on the original task inputs."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+from tempfile import TemporaryDirectory
+
+
+def resize_video(input_root, output_path):
+    from moviepy import VideoFileClip
+
+    target_width, target_height = 640, 480
+    video_path = input_root / "MoviePy_gen01_input.webm"
+    with VideoFileClip(str(video_path)) as source:
+        width, height = source.size
+        scale = min(target_width / width, target_height / height)
+        fitted_size = (round(width * scale), round(height * scale))
+        resized = source.resized(new_size=fitted_size)
+        with resized.with_background_color(
+            size=(target_width, target_height), color=(0, 0, 0), pos="center"
+        ) as letterboxed:
+            letterboxed.write_videofile(
+                str(output_path),
+                fps=source.fps,
+                codec="libx264",
+                audio=source.audio is not None,
+                audio_codec="aac",
+                temp_audiofile=str(output_path.with_name("audio.m4a")),
+                threads=2,
+                logger=None,
+            )
+    return {"canvas": [target_width, target_height], "content_size": fitted_size, "codec": "h264"}
+
+
+def select_hsv(input_root, output_path):
+    import numpy as np
+    from PIL import Image
+
+    with Image.open(input_root / "Pillow_gen01_input.jpg") as source:
+        hsv = np.asarray(source.convert("RGB").convert("HSV"), dtype=np.float64)
+    hue = hsv[..., 0] * (360 / 255)
+    saturation = hsv[..., 1] / 255
+    value = hsv[..., 2] / 255
+    selected = (20 <= hue) & (hue <= 40) & (saturation >= 0.3) & (value >= 0.4)
+    Image.fromarray(selected.astype(np.uint8) * 255).save(output_path, format="PNG")
+    return {"size": list(selected.shape[::-1]), "foreground_fraction": float(selected.mean())}
+
+
+def grayscale_pixels(image):
+    import numpy as np
+
+    if image.mode == "P":
+        image = image.convert("RGBA")
+    values = np.asarray(image)
+    if values.ndim == 2:
+        return values
+    if image.mode in {"RGB", "RGBA"}:
+        if image.mode == "RGBA" and not (values[..., 3] == 255).all():
+            return None
+        if (values[..., :3] == values[..., :1]).all():
+            return values[..., 0]
+    return None
+
+
+def color_connected_components(input_root, output_path):
+    import numpy as np
+    from PIL import Image
+    from skimage.measure import label
+
+    input_directory = input_root / "ScikitImage_gen05_input"
+    candidates = []
+    for candidate in sorted(input_directory.iterdir()):
+        if not candidate.is_file() or candidate.suffix.lower() != ".png":
+            continue
+        with Image.open(candidate) as image:
+            gray = grayscale_pixels(image)
+            if gray is not None:
+                values = np.unique(gray)
+                # A binary mask has a zero background and a nonzero foreground.
+                if len(values) == 2 and values[0] == 0 and values[1] > 0:
+                    candidates.append((candidate, gray != 0))
+    if len(candidates) != 1:
+        raise ValueError(f"Expected one binary PNG mask with background and foreground, found {len(candidates)}")
+
+    source, foreground = candidates[0]
+    labels, count = label(foreground, background=0, connectivity=2, return_num=True)
+    if count > 0xFFFFFF:
+        raise ValueError("There are more foreground regions than distinct nonblack RGB colors")
+    component_ids = np.arange(count + 1, dtype=np.uint32)
+    # An odd multiplier is one-to-one modulo 2**24, leaving label zero black.
+    colors = (component_ids * 0x9E3779) & 0xFFFFFF
+    palette = np.column_stack((colors >> 16, (colors >> 8) & 255, colors & 255)).astype(np.uint8)
+    Image.fromarray(palette[labels]).save(output_path, format="PNG")
+    return {"input": source.name, "components": int(count), "size": list(foreground.shape[::-1])}
+
+
+def make_otsu_mask(input_root, output_path):
+    import numpy as np
+    from PIL import Image
+    from skimage.filters import threshold_otsu
+
+    with Image.open(input_root / "ScikitImage_gen06_input.png") as source:
+        gray = grayscale_pixels(source)
+    if gray is None:
+        raise ValueError("Otsu input must be a grayscale image")
+    # Estimate the threshold before converting to 8-bit output.
+    threshold = threshold_otsu(gray)
+    foreground = gray > threshold
+    Image.fromarray(foreground.astype(np.uint8) * 255).save(output_path, format="PNG")
+    return {
+        "size": list(foreground.shape[::-1]),
+        "threshold": float(threshold),
+        "foreground_fraction": float(foreground.mean()),
+    }
+
+
+TASKS = {
+    "MoviePy_gen01": (resize_video, "resized_output.mp4"),
+    "Pillow_gen01": (select_hsv, "color_mask.png"),
+    "ScikitImage_gen05": (color_connected_components, "labeled_components.png"),
+    "ScikitImage_gen06": (make_otsu_mask, "mask.png"),
+}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("task_id", choices=TASKS)
+    parser.add_argument("input_root", type=Path)
+    parser.add_argument("output_root", type=Path)
+    args = parser.parse_args()
+
+    process, filename = TASKS[args.task_id]
+    try:
+        with TemporaryDirectory(dir=args.output_root) as temporary:
+            pending_output = Path(temporary) / filename
+            summary = process(args.input_root, pending_output)
+            os.replace(pending_output, args.output_root / filename)
+    except (OSError, ValueError, ImportError) as error:
+        print(f"{args.task_id}: {error}", file=sys.stderr)
+        return 1
+
+    print(json.dumps({"task_id": args.task_id, "output": filename, **summary}))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
