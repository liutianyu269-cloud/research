+package com.horsecoder.skilllab.liutianyu;
+
+import cc.eamon.open.flow.core.FlowEngine;
+import cc.eamon.open.flow.core.stereotype.Flow;
+import cc.eamon.open.flow.spring.FlowComponent;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.TimeUnit;
+
+@FlowComponent
+public class SkillLabFlow {
+    private final ObjectMapper json;
+
+    public SkillLabFlow(ObjectMapper json) {
+        this.json = json;
+    }
+
+    @Flow("LIUTIANYU_MANUAL_SKILL_DISPATCH")
+    public void dispatch(String structure) throws Exception {
+        String result;
+        try {
+            result = callRunner(structure);
+        } catch (InterruptedException error) {
+            Thread.currentThread().interrupt();
+            result = failure("本地执行已中断");
+        } catch (Exception error) {
+            result = failure(error.getMessage() == null ? "本地执行失败" : error.getMessage());
+        }
+        FlowEngine.instance().register("result", result);
+    }
+
+    private String callRunner(String payload) throws Exception {
+        String runner = System.getenv("LIUTIANYU_SKILL_LAUNCHER");
+        String workspace = System.getenv("LIUTIANYU_SKILL_WORKSPACE");
+        if (runner == null || runner.isEmpty() || workspace == null || workspace.isEmpty()) {
+            return failure("请设置 Skill 启动脚本和原题数据目录的 WSL 路径");
+        }
+        Process process = new ProcessBuilder("wsl.exe", "-d", "Ubuntu", "--exec", "sh", runner, workspace)
+            .redirectError(ProcessBuilder.Redirect.INHERIT).start();
+        try {
+            CompletableFuture<String> response = CompletableFuture.supplyAsync(() -> readOutput(process));
+            try (OutputStream input = process.getOutputStream()) {
+                input.write(payload.getBytes(StandardCharsets.UTF_8));
+            }
+            if (!process.waitFor(185, TimeUnit.SECONDS)) {
+                throw new IOException("本地 Skill 或评分器执行超时");
+            }
+            if (process.exitValue() != 0) {
+                throw new IOException("本地执行程序退出，状态 " + process.exitValue());
+            }
+            return response.get(5, TimeUnit.SECONDS);
+        } finally {
+            if (process.isAlive()) {
+                process.destroyForcibly();
+            }
+        }
+    }
+
+    private String readOutput(Process process) {
+        try (InputStream input = process.getInputStream()) {
+            ByteArrayOutputStream buffer = new ByteArrayOutputStream();
+            byte[] chunk = new byte[4096];
+            int count;
+            while ((count = input.read(chunk)) != -1) {
+                if (buffer.size() + count > 4 * 1024 * 1024) {
+                    throw new IOException("本地执行返回的数据过大");
+                }
+                buffer.write(chunk, 0, count);
+            }
+            return new String(buffer.toByteArray(), StandardCharsets.UTF_8);
+        } catch (IOException error) {
+            throw new CompletionException(error);
+        }
+    }
+
+    private String failure(String message) {
+        return json.createObjectNode().put("ok", false).put("error", message).toString();
+    }
+}
