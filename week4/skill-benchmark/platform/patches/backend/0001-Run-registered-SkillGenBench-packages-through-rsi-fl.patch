+package com.horsecoder.skilllab.liutianyu;
+
+import cc.eamon.open.flow.remote.FlowRequest;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.horsecoder.common.whuTalent.core.flow.FlowEngineService;
+import java.util.Map;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.CrossOrigin;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@CrossOrigin(origins = {"http://127.0.0.1:3105", "http://localhost:3105"})
+public class SkillLabController {
+    private static final String FLOW_ID = "@com.horsecoder.skilllab.liutianyu/MANUAL_SKILL_LAB";
+    private final FlowEngineService flows;
+    private final ObjectMapper json;
+
+    public SkillLabController(FlowEngineService flows, ObjectMapper json) {
+        this.flows = flows;
+        this.json = json;
+    }
+
+    @PostMapping("/api/engine/flow")
+    public ResponseEntity<JsonNode> run(@RequestBody FlowRequest request) throws Exception {
+        Map<String, Object> params = request.getParams();
+        if (!FLOW_ID.equals(request.getFlowId()) || params == null || params.size() != 1
+                || !(params.get("structure") instanceof String)
+                || ((String) params.get("structure")).length() > 16000) {
+            return ResponseEntity.badRequest().body(problem("无效的人工编排请求"));
+        }
+        Object result = flows.runFlowByFlowId(request).get("result");
+        if (!(result instanceof String)) {
+            return ResponseEntity.status(HttpStatus.BAD_GATEWAY).body(problem("rsi-flow 未返回执行结果"));
+        }
+        JsonNode payload = json.readTree((String) result);
+        return ResponseEntity.status(payload.path("ok").asBoolean() ? HttpStatus.OK : HttpStatus.BAD_REQUEST)
+            .body(payload);
+    }
+
+    private JsonNode problem(String message) {
+        return json.createObjectNode().put("ok", false).put("error", message);
+    }
+}
