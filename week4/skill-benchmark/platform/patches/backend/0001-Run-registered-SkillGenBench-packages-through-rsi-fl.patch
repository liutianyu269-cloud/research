+"""Execute the manually assembled SkillGenBench workflow against the original inputs."""
+import argparse
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+from tempfile import NamedTemporaryFile, TemporaryDirectory
+from uuid import uuid4
+from zipfile import ZipFile
+
+from validation import check_artifact
+
+HERE = Path(__file__).resolve().parent
+STAGES = ("read", "execute", "validate", "grade")
+TASKS = {
+    "Eparse_gtb01": ("documents", "eparse_report.txt", "Eparse_01/gt.txt"),
+    "Eparse_gtb02": ("documents", "eparse_cells.jsonl", "Eparse_02/gt.txt"),
+    "MoviePy_gen01": ("media", "resized_output.mp4", ""),
+    "NeuroKit_gtb01": ("signals", "eda_scr_metrics.csv", "NeuroKit_01/gt.csv"),
+    "NeuroKit_gtb02": ("signals", "ecg_peaks.csv", "NeuroKit_02/gt.csv"),
+    "NeuroKit_gtb03": ("signals", "eog_metrics.csv", "NeuroKit_03/gt.csv"),
+    "Pillow_gen01": ("media", "color_mask.png", ""),
+    "PyPDF2_gtb03": ("documents", "pdf_metadata.json", "PyPDF2_03/gt.json"),
+    "ScikitImage_gen05": ("media", "labeled_components.png", ""),
+    "ScikitImage_gen06": ("media", "mask.png", ""),
+}
+METHODS = {
+    "Eparse_gtb01": ("复核工作簿与报告布局", "按文件和工作表遍历，保留表头与原值。"),
+    "Eparse_gtb02": ("逐单元格写出 JSON Lines", "从 Eparse 按行提取单元格记录；将格式争议留在评分侧。"),
+    "MoviePy_gen01": ("等比缩放与居中补边", "按短边适配画布，保持帧率和画幅，编码 H.264。"),
+    "NeuroKit_gtb01": ("汇总 EDA 的 SCR 与 tonic 指标", "复用 EDA 清洗和峰值检测，按已核对的采样率计算三项统计。"),
+    "NeuroKit_gtb02": ("导出 ECG 的 R/P 峰索引", "使用 150 Hz 处理 ECG，按检测列导出索引列表。"),
+    "NeuroKit_gtb03": ("提取呼吸峰与呼吸频率", "读取实际存在的 RSP 列；采样率 100 Hz 来自匹配的 NeuroKit 公开样例。"),
+    "Pillow_gen01": ("按 HSV 范围生成掩膜", "转换颜色尺度后合并三个通道条件，输出 0/255 的 L 模式 PNG。"),
+    "PyPDF2_gtb03": ("输出 PDF 文档元数据", "从文档信息字典读取命名字段，统一日期表示。"),
+    "ScikitImage_gen05": ("找到二值掩膜并着色", "识别带前景和背景的有效输入，按连通域分配 RGB 颜色。"),
+    "ScikitImage_gen06": ("以原始灰度计算 Otsu 阈值", "逐像素应用灰度大于阈值的规则，保留原尺寸并输出 8 位 PNG。"),
+}
+HISTORICAL_ISSUES = {
+    "NeuroKit_gtb01": "上次模型耗尽输出额度，未取得有效分数。",
+    "ScikitImage_gen05": "旧评分器找不到掩膜；历史诊断中产物只有一种颜色。",
+}
+KNOWN_CONFLICTS = {
+    "Eparse_gtb02": "原题要求逐行 JSON，旧评分器整文件调用 json.loads。",
+    "ScikitImage_gen05": "原评分器在输入路径下找不到掩膜；题包将二值图放在子目录中。",
+    "ScikitImage_gen06": "原图按题面执行 Otsu 得出 1.17% 前景；旧评分器要求至少 5%。",
+}
+PUBLIC_SOURCES = {
+    "eparse": "https://github.com/ChrisPappalardo/eparse",
+    "moviepy": "https://github.com/Zulko/moviepy",
+    "neurokit": "https://github.com/neuropsychology/NeuroKit",
+    "pillow": "https://github.com/python-pillow/Pillow",
+    "pypdf2": "https://github.com/py-pdf/pypdf",
+    "scikitimage": "https://github.com/scikit-image/scikit-image",
+}
+
+
+def make_catalog(workspace):
+    archive = workspace / "outputs"
+    comparison = json.loads((archive / "skillgenbench-dsh-10-comparison.json").read_text())
+    mapping = json.loads((archive / "skillgenbench-50-task-map.json").read_text())
+    skills = {row["task_id"]: row for row in mapping["tasks"]}
+    catalog = {}
+    for row in comparison["tasks"]:
+        task_id = row["task_id"]
+        if task_id not in TASKS:
+            continue
+        skill = skills[task_id]
+        domain, output, reference = TASKS[task_id]
+        title, method = METHODS[task_id]
+        trial = workspace / "work" / "sgb-dsh-ab" / row["with_skill_trial_dir"] / "task"
+        dirs = sorted(path for path in trial.iterdir() if path.is_dir())
+        if len(dirs) != 1:
+            raise ValueError(f"{task_id} 缺少唯一的原始任务目录")
+        origin = reference.split("/", 1)[0] if reference else None
+        catalog[task_id] = {
+            "id": task_id, "title": title, "method": method, "skill": skill["skill_name"],
+            "source": PUBLIC_SOURCES[skill["collection"]], "upstreamCase": origin,
+            "oldScore": row["with_skill_native_score"], "noSkillScore": row["no_skill_mean_native_score"],
+            "oldProblem": HISTORICAL_ISSUES.get(task_id) or row["with_skill_native_comment"] or "旧记录未提供评分",
+            "oldStatus": row["with_skill_status"], "conflict": KNOWN_CONFLICTS.get(task_id),
+            "output": output, "domain": domain, "reference": reference, "trial": dirs[0],
+        }
+    return catalog
+
+
+def atomic_json(destination, value):
+    with NamedTemporaryFile(mode="w", encoding="utf-8", dir=destination.parent, delete=False) as stream:
+        temporary = Path(stream.name)
+        json.dump(value, stream, ensure_ascii=False, indent=2)
+    try:
+        os.replace(temporary, destination)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def call_script(command, cwd):
+    env = {
+        "PATH": os.environ["PATH"],
+        "HOME": str(cwd),
+        "LANG": "C.UTF-8",
+        "MPLBACKEND": "Agg",
+        "OPENBLAS_NUM_THREADS": "1",
+        "PYTHONDONTWRITEBYTECODE": "1",
+    }
+    return subprocess.run(command, cwd=cwd, env=env, text=True, encoding="utf-8",
+                          errors="replace", capture_output=True, timeout=100)
+
+
+def register_package(workspace, state_dir, case):
+    with ZipFile(workspace / "outputs" / "skillgenbench-50-skills.zip") as archive:
+        original = archive.read(f"skills/{case['skill']}/SKILL.md")
+    original_sha = hashlib.sha256(original).hexdigest()
+    source_script = HERE / "solutions" / f"{case['domain']}.py"
+    script = source_script.read_bytes()
+    task = case["id"]
+    name = f"{case['skill']}-manual"
+    body = (
+        f"---\nname: {name}\ndescription: {json.dumps(case['method'], ensure_ascii=False)}\n---\n\n"
+        f"# {case['title']}\n\n"
+        f"{case['method']}\n\n"
+        f"技术来源 [{case['domain']}]({case['source']})。对应 SkillGenBench 题目 `{task}`。\n\n"
+        f"```sh\npython scripts/{source_script.name} {task} INPUT_DIR OUTPUT_DIR\n```\n\n"
+        f"脚本从题包的输入目录读取数据，在输出目录写入 `{case['output']}`。输出目录须已存在。\n\n"
+        f"历史 Skill SHA-256 `{original_sha}`\n"
+    )
+    markdown = body.encode("utf-8")
+    package_sha = hashlib.sha256(markdown + b"\0" + script).hexdigest()
+    revisions = state_dir / "skills" / task
+    package = revisions / package_sha
+    if not package.is_dir():
+        revisions.mkdir(parents=True, exist_ok=True)
+        with TemporaryDirectory(dir=revisions) as temporary:
+            staged = Path(temporary) / name
+            (staged / "scripts").mkdir(parents=True)
+            (staged / "SKILL.md").write_bytes(markdown)
+            (staged / "scripts" / source_script.name).write_bytes(script)
+            staged.rename(package)
+    return package_sha
+
+
+def loaded_package(state_dir, case, revision):
+    package = state_dir / "skills" / case["id"] / revision
+    worker = package / "scripts" / f"{case['domain']}.py"
+    markdown = (package / "SKILL.md").read_bytes()
+    if hashlib.sha256(markdown + b"\0" + worker.read_bytes()).hexdigest() != revision:
+        raise ValueError("注册包内容与已登记的哈希不一致，请重新注册")
+    return worker, {"sha256": revision, "body": markdown.decode("utf-8"),
+                    "manualMethod": case["method"]}
+
+
+def grade_artifact(case, output, input_root, run_dir):
+    grading = case["trial"] / "grading"
+    score_path = run_dir / "native-score.jsonl"
+    if case["reference"]:
+        grader = grading / "tests" / "test_script.py"
+        reference = grading / "groundtruth" / case["reference"]
+        extra = ["--groundtruth", str(reference)]
+        reference_exists = reference.is_file()
+    else:
+        grader = grading / "tests" / "test_outputs.py"
+        extra = ["--input-dir", str(input_root)] if case["id"] == "ScikitImage_gen05" else []
+        reference_exists = None
+    command = [sys.executable, str(grader), "--output", str(output), "--result", str(score_path), *extra]
+    completed = call_script(command, run_dir)
+    (run_dir / "grader.log").write_text(completed.stdout + completed.stderr, encoding="utf-8")
+    if not score_path.is_file():
+        return {"status": "error", "value": None, "process": None,
+                "comment": "原评分器未写出结果，见 grader.log", "exitCode": completed.returncode}
+    results = [line for line in score_path.read_text(encoding="utf-8").splitlines() if line.strip()]
+    native = json.loads(results[-1]) if results else {}
+    process = native.get("Process")
+    result = native.get("Result")
+    value = int(result) if process is True and isinstance(result, bool) else None
+    return {"status": "scored" if value is not None else "unscored", "value": value,
+            "process": process, "comment": native.get("comments") or native.get("Comments"),
+            "exitCode": completed.returncode, "referenceAvailable": reference_exists,
+            "graderSha256": hashlib.sha256(grader.read_bytes()).hexdigest()}
+
+
+def run_workflow(state_dir, case, revision, steps):
+    if not isinstance(steps, list) or steps[:2] != list(STAGES[:2]) or steps != [
+        stage for stage in STAGES if stage in steps
+    ]:
+        raise ValueError("流程先读取输入、再执行 Skill，校验和复评按顺序选用")
+    inputs = case["trial"] / "context" / "input"
+    if not any(path.is_file() for path in inputs.rglob("*")):
+        raise ValueError("原始任务输入缺失")
+    worker, description = loaded_package(state_dir, case, revision)
+    run_dir = state_dir / "runs" / f"{case['id']}-{uuid4().hex[:12]}"
+    output_dir = run_dir / "output"
+    output_dir.mkdir(parents=True)
+    output = output_dir / case["output"]
+    public_run = {"id": run_dir.name, "task": case["id"], "steps": steps,
+                  "artifact": None, "skill": description, "stepsDone": ["read"],
+                  "score": None, "validation": None, "status": "error", "message": None}
+    try:
+        completed = call_script([sys.executable, str(worker), case["id"], str(inputs), str(output_dir)], run_dir)
+        (run_dir / "execution.log").write_text(completed.stdout + completed.stderr, encoding="utf-8")
+        if completed.returncode != 0:
+            raise RuntimeError(f"Skill 执行退出码 {completed.returncode}，见 execution.log")
+        public_run["stepsDone"].append("execute")
+        if not output.is_file() or output.stat().st_size == 0:
+            raise RuntimeError(f"缺少非空产物 {case['output']}")
+        public_run["artifact"] = {"name": output.name, "bytes": output.stat().st_size,
+                                  "sha256": hashlib.sha256(output.read_bytes()).hexdigest()}
+        if "validate" in steps:
+            try:
+                message = check_artifact(case["id"], inputs, output)
+                public_run["validation"] = {"passed": True, "message": message}
+            except (OSError, ValueError) as exc:
+                public_run["validation"] = {"passed": False, "message": str(exc)}
+            public_run["stepsDone"].append("validate")
+        if "grade" in steps:
+            public_run["score"] = grade_artifact(case, output, inputs, run_dir)
+            public_run["stepsDone"].append("grade")
+        public_run["status"] = "produced"
+    except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as exc:
+        public_run["message"] = str(exc)
+    atomic_json(run_dir / "result.json", public_run)
+    return public_run
+
+
+def dispatch(workspace, request):
+    if not isinstance(request, dict):
+        raise ValueError("请求须为 JSON 对象")
+    catalog = make_catalog(workspace)
+    state_dir = workspace / "outputs" / "liutianyu-skill-lab"
+    state_dir.mkdir(parents=True, exist_ok=True)
+    saved = state_dir / "registry.json"
+    action = request.get("action")
+    task = request.get("task")
+    with (state_dir / ".registry.lock").open("w", encoding="utf-8") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        state = json.loads(saved.read_text()) if saved.exists() else {"loaded": [], "latest": {}}
+        revisions = state.setdefault("revisions", {})
+        if action == "list":
+            public = [{key: value for key, value in case.items() if key not in {
+                "domain", "trial", "reference"
+            }} for case in catalog.values()]
+            return {"cases": public, "loaded": state["loaded"], "latest": state["latest"]}
+        if not isinstance(task, str) or not re.fullmatch(r"[A-Za-z0-9_]+", task) or task not in catalog:
+            raise ValueError("请指定目录内的任务 ID")
+        case = catalog[task]
+        if action == "register":
+            revisions[task] = register_package(workspace, state_dir, case)
+            if task not in state["loaded"]:
+                state["loaded"].append(task)
+        elif action == "unload":
+            state["loaded"] = [value for value in state["loaded"] if value != task]
+            revisions.pop(task, None)
+        elif action == "run":
+            if task not in state["loaded"]:
+                raise ValueError("Skill 当前未加载，请先注册")
+            # Materialize revisions on first use for registrations from the previous format.
+            if task not in revisions:
+                revisions[task] = register_package(workspace, state_dir, case)
+            state["latest"][task] = run_workflow(state_dir, case, revisions[task], request.get("steps"))
+        else:
+            raise ValueError("无效的操作")
+        atomic_json(saved, state)
+    return {"loaded": state["loaded"], "latest": state["latest"], "task": task}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--workspace", type=Path, required=True)
+    args = parser.parse_args()
+    try:
+        result = dispatch(args.workspace.resolve(), json.load(sys.stdin))
+        print(json.dumps({"ok": True, "data": result}, ensure_ascii=False))
+    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired) as exc:
+        print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
