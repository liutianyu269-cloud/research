+"""Check concrete public task requirements independently of the native score."""
+
+import csv
+import json
+
+
+def check_artifact(task, inputs, output):
+    if task == "Eparse_gtb01":
+        from openpyxl import load_workbook
+
+        report = output.read_text(encoding="utf-8")
+        count = 0
+        for path in sorted((inputs / "Eparse_gtb01_input").glob("*.xlsx")):
+            if path.name.startswith("~$"):
+                continue
+            if f"File name: {path.name}\n" not in report:
+                raise ValueError(f"报告缺少工作簿 {path.name}")
+            workbook = load_workbook(path, read_only=True)
+            try:
+                for sheet in workbook.sheetnames:
+                    if f"Sheet name: {sheet}\n" not in report:
+                        raise ValueError(f"报告缺少工作表 {sheet}")
+                    count += 1
+            finally:
+                workbook.close()
+        return f"报告覆盖 {count} 张工作表。"
+
+    if task == "Eparse_gtb02":
+        from openpyxl import load_workbook
+
+        fields = {"row", "column", "value", "type", "c_header", "r_header", "excel_RC", "sheet", "f_name"}
+        keys = set()
+        with output.open(encoding="utf-8") as lines:
+            for number, line in enumerate(lines, start=1):
+                cell = json.loads(line)
+                if not isinstance(cell, dict) or not fields.issubset(cell):
+                    raise ValueError(f"第 {number} 行没有完整的单元格字段")
+                key = (cell["sheet"], cell["excel_RC"])
+                if key in keys:
+                    raise ValueError(f"第 {number} 行的单元格已写出")
+                keys.add(key)
+        workbook = load_workbook(inputs / "Eparse_gtb02_input.xlsx", read_only=True)
+        try:
+            expected = {(sheet.title, cell.coordinate) for sheet in workbook for row in sheet
+                        for cell in row if cell.value is not None}
+        finally:
+            workbook.close()
+        if keys != expected:
+            raise ValueError("JSON Lines 未精确覆盖工作簿的非空单元格")
+        return f"{len(keys)} 行有效 JSON 对象，覆盖原工作簿的非空单元格。"
+
+    if task.startswith("NeuroKit_"):
+        with output.open(encoding="utf-8", newline="") as stream:
+            reader = csv.DictReader(stream)
+            rows = list(reader)
+        required = {
+            "NeuroKit_gtb01": ("SCR_Peaks_Amplitude_Mean", "SCR_Peaks_N", "EDA_Tonic_SD"),
+            "NeuroKit_gtb02": ("ECG_R_Peaks", "ECG_P_Peaks"),
+            "NeuroKit_gtb03": ("Mean_Respiratory_Rate_BPM", "Peak_Times_Seconds", "Number_of_Peaks"),
+        }[task]
+        if len(rows) != 1 or not set(required).issubset(rows[0]):
+            raise ValueError("CSV 应为包含请求指标的一行数据")
+        metrics = rows[0]
+        if task == "NeuroKit_gtb01":
+            tuple(float(metrics[field]) for field in required if metrics[field] != "")
+            return "EDA 汇总表包含三项指标。"
+        values = [json.loads(metrics[field]) for field in required]
+        if not all(isinstance(value, list) for value in values):
+            raise ValueError("CSV 指标列必须使用列表格式")
+        if task == "NeuroKit_gtb03" and values[2] != [len(values[1])]:
+            raise ValueError("呼吸峰数量与峰时刻列表不一致")
+        return "CSV 指标列使用列表格式。"
+
+    if task == "PyPDF2_gtb03":
+        from PyPDF2 import PdfReader
+
+        metadata = json.loads(output.read_text(encoding="utf-8"))
+        with (inputs / "PyPDF2_gtb03_input.pdf").open("rb") as source:
+            original = PdfReader(source).metadata or {}
+            for field, key in (("author", "/Author"), ("title", "/Title"),
+                               ("subject", "/Subject"), ("creator", "/Creator"),
+                               ("producer", "/Producer")):
+                if key in original and metadata.get(field) != str(original[key]):
+                    raise ValueError(f"PDF 元数据字段 {field} 与原文档不一致")
+            if "/CreationDate" in original and not metadata.get("creation_date"):
+                raise ValueError("源文档创建日期未写入")
+        return "JSON 可读取，已核对原文档的命名字段和创建日期是否写入。"
+
+    if task == "MoviePy_gen01":
+        import cv2
+
+        video = cv2.VideoCapture(str(output))
+        try:
+            available, frame = video.read()
+            if not available or frame.shape[:2] != (480, 640):
+                raise ValueError("视频必须可解码为 640×480")
+        finally:
+            video.release()
+        return "输出视频可解码，尺寸为 640×480。"
+
+    return check_image(task, inputs, output)
+
+
+def check_image(task, inputs, output):
+    import numpy as np
+    from PIL import Image
+
+    with Image.open(output) as image:
+        if image.format != "PNG":
+            raise ValueError("产物必须是 PNG")
+        mode, size = image.mode, image.size
+        pixels = np.asarray(image)
+    if task == "ScikitImage_gen05":
+        from skimage.measure import label
+
+        source = inputs / "ScikitImage_gen05_input" / "search_image.png"
+        with Image.open(source) as image:
+            foreground = np.asarray(image.convert("L")) != 0
+        if mode != "RGB" or pixels.shape[:2] != foreground.shape or np.any(pixels[~foreground]):
+            raise ValueError("着色图必须与原掩膜同尺寸、使用 RGB，并保持背景为黑色")
+        labels, count = label(foreground, connectivity=2, return_num=True)
+        colors = set()
+        for component in range(1, count + 1):
+            values = np.unique(pixels[labels == component], axis=0)
+            if len(values) != 1 or not values[0].any():
+                raise ValueError("每个前景连通域须使用单一的非黑色")
+            colors.add(tuple(values[0]))
+        if len(colors) != count:
+            raise ValueError("不同连通域须使用不同颜色")
+        return f"背景为黑色，{count} 个连通域各用一种不同的 RGB 颜色。"
+
+    if mode != "L" or not set(np.unique(pixels)).issubset({0, 255}):
+        raise ValueError("掩膜必须是 8 位单通道的 0/255 PNG")
+    if task == "ScikitImage_gen06":
+        from skimage.filters import threshold_otsu
+
+        with Image.open(inputs / "ScikitImage_gen06_input.png") as image:
+            original = np.asarray(image)
+        threshold = threshold_otsu(original)
+        expected = original > threshold
+        if pixels.shape != expected.shape or not np.array_equal(pixels == 255, expected):
+            raise ValueError("产物与题面规定的逐像素 Otsu 掩膜不一致")
+        return f"逐像素匹配原图 Otsu 掩膜，阈值 {threshold:g}，前景 {expected.mean():.2%}。"
+
+    with Image.open(inputs / "Pillow_gen01_input.jpg") as image:
+        if size != image.size:
+            raise ValueError("掩膜尺寸与原图不一致")
+    return "掩膜与原图同尺寸，使用 8 位单通道和 0/255 两种像素。"
