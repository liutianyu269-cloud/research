+package com.horsecoder.skilllab.liutianyu;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.node.ObjectNode;
+import com.horsecoder.skilllab.liutianyu.SkillLabV2Catalog.Dataset;
+import com.horsecoder.skilllab.liutianyu.SkillLabV2Catalog.Fixture;
+import com.horsecoder.skilllab.liutianyu.SkillLabV2Catalog.Skill;
+import com.horsecoder.skilllab.liutianyu.SkillLabV2Catalog.Snapshot;
+import com.horsecoder.skilllab.liutianyu.SkillLabV2Runner.Invocation;
+import com.horsecoder.skilllab.liutianyu.SkillLabV2Runner.Result;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.http.converter.HttpMessageNotReadableException;
+import org.springframework.web.bind.annotation.CrossOrigin;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/api/skill-lab/v2")
+@CrossOrigin(origins = {"http://127.0.0.1:3105", "http://localhost:3105", "http://127.0.0.1:3106", "http://localhost:3106"})
+public class SkillLabV2Controller {
+    private static final Logger log = LoggerFactory.getLogger(SkillLabV2Controller.class);
+    private static final int MAX_NODES = 10;
+    private final SkillLabV2Catalog catalog;
+    private final SkillLabV2Engine engine;
+    private final ObjectMapper json;
+
+    public SkillLabV2Controller(SkillLabV2Catalog catalog, SkillLabV2Engine engine, ObjectMapper json) {
+        this.catalog = catalog;
+        this.engine = engine;
+        this.json = json;
+    }
+
+    @GetMapping("/catalog")
+    public Map<String, Object> list() throws IOException {
+        Snapshot snapshot = catalog.read();
+        Map<String, Object> response = new LinkedHashMap<>();
+        response.put("datasets", snapshot.datasets);
+        response.put("skills", snapshot.skills.values());
+        response.put("registrations", engine.registrations(snapshot.skills.keySet()));
+        return response;
+    }
+
+    @PutMapping("/registry/{id}")
+    public SkillLabV2Engine.Registration change(@PathVariable String id, @RequestBody RegistryAction body)
+            throws Exception {
+        Skill skill = catalog.read().skills.get(id);
+        if (skill == null || body == null || !("register".equals(body.action) || "reload".equals(body.action)
+                || "revoke".equals(body.action))) {
+            throw new IllegalArgumentException("未知 Skill 或注册操作");
+        }
+        if (!"revoke".equals(body.action) && skill.script != null) {
+            requireFile(catalog.root(), skill.script);
+            requireFile(catalog.root(), skill.skillFile);
+        }
+        return engine.change(id, !"revoke".equals(body.action));
+    }
+
+    @PostMapping("/runs")
+    public Run run(@RequestBody Workflow workflow) throws IOException {
+        Snapshot snapshot = catalog.read();
+        Fixture fixture = fixture(snapshot, workflow);
+        Map<String, String> outputTypes = validate(workflow, snapshot, fixture);
+        Path root = catalog.root();
+        Path fixtures = SkillLabV2Catalog.inside(root, fixture.inputRoot);
+        if (!Files.isDirectory(fixtures)) {
+            throw new IllegalArgumentException("场景输入应为目录");
+        }
+        Path runs = root.resolve("work/skill-lab-v2/platform/runs");
+        Files.createDirectories(runs);
+        if (!runs.toRealPath().startsWith(root)) {
+            throw new IOException("运行目录位于课程工作区之外");
+        }
+
+        Run run = new Run();
+        run.id = UUID.randomUUID().toString();
+        run.workflow = workflow;
+        run.status = "passed";
+        Path runFolder = Files.createDirectory(runs.resolve(run.id));
+        run.directory = displayPath(root, runFolder);
+        Map<String, Path> completed = new LinkedHashMap<>();
+        for (Node node : workflow.nodes) {
+            Skill skill = snapshot.skills.get(node.skillId);
+            Path step = Files.createDirectory(runFolder.resolve(node.id));
+            Path source = "case".equals(node.input.from) ? fixtures : completed.get(node.input.nodeId);
+            Invocation invocation = new Invocation();
+            invocation.skillId = skill.id;
+            invocation.argument = fixture.skillArgument;
+            invocation.expected = fixture.expectedOutput;
+            invocation.input = source.toString();
+            invocation.output = step.resolve("output").toString();
+
+            NodeResult trace = new NodeResult();
+            trace.id = node.id;
+            trace.skillId = skill.id;
+            trace.outputType = outputTypes.get(node.id);
+            trace.inputDirectory = displayPath(root, source);
+            long started = System.nanoTime();
+            try {
+                if (skill.script != null) {
+                    invocation.script = requireFile(root, skill.script).toString();
+                }
+                Result result = engine.execute(skill.id, invocation);
+                trace.flowId = result.flowId;
+                trace.generation = result.generation;
+                if (result.error != null) {
+                    trace.error = result.error;
+                } else {
+                    Path produced = Paths.get(result.directory);
+                    completed.put(node.id, produced);
+                    trace.outputDirectory = displayPath(root, produced);
+                    trace.artifacts = result.artifacts;
+                }
+            } catch (Exception error) {
+                log.warn("Skill node {} failed", node.id, error);
+                trace.error = error.getMessage() == null ? error.getClass().getSimpleName() : error.getMessage();
+            }
+            trace.elapsedMs = (System.nanoTime() - started) / 1_000_000;
+            trace.status = trace.error == null ? "passed" : "failed";
+            run.nodes.add(trace);
+            if (trace.error != null) {
+                run.status = "failed";
+                break;
+            }
+        }
+        json.writerWithDefaultPrettyPrinter().writeValue(runFolder.resolve("run.json").toFile(), run);
+        return run;
+    }
+
+    private Fixture fixture(Snapshot snapshot, Workflow workflow) {
+        if (workflow != null && workflow.dataset != null && workflow.caseId != null) {
+            for (Dataset dataset : snapshot.datasets) {
+                if (dataset.dataset.equals(workflow.dataset)) {
+                    for (Fixture fixture : dataset.cases) {
+                        if (fixture.id.equals(workflow.caseId)) {
+                            return fixture;
+                        }
+                    }
+                }
+            }
+        }
+        throw new IllegalArgumentException("未知数据集或回归场景");
+    }
+
+    private Map<String, String> validate(Workflow workflow, Snapshot snapshot, Fixture fixture) {
+        String fixtureType = snapshot.skills.get(fixture.skillId).inputType;
+        if (workflow.nodes == null || workflow.nodes.isEmpty() || workflow.nodes.size() > MAX_NODES) {
+            throw new IllegalArgumentException("工作流必须包含 1–" + MAX_NODES + " 个节点");
+        }
+        Map<String, SkillLabV2Engine.Registration> states = engine.registrations(snapshot.skills.keySet());
+        Map<String, String> outputs = new LinkedHashMap<>();
+        for (Node node : workflow.nodes) {
+            if (node == null || node.id == null || !node.id.matches("node-[a-zA-Z0-9_-]{1,100}")
+                    || outputs.containsKey(node.id) || node.input == null) {
+                throw new IllegalArgumentException("节点缺少有效的唯一 ID 或输入端口");
+            }
+            Skill skill = snapshot.skills.get(node.skillId);
+            if (skill == null) {
+                throw new IllegalArgumentException("节点引用未知 Skill " + node.id);
+            }
+            if (!states.get(skill.id).loaded) {
+                throw new IllegalStateException("请先在课程后端装配 Skill " + skill.id);
+            }
+            Input input = node.input;
+            String sourceType;
+            if ("case".equals(input.from) && "fixtures".equals(input.port) && input.nodeId == null) {
+                sourceType = fixtureType;
+            } else if ("node".equals(input.from) && "artifact".equals(input.port) && outputs.containsKey(input.nodeId)) {
+                sourceType = outputs.get(input.nodeId);
+            } else {
+                throw new IllegalArgumentException("节点 " + node.id + " 必须连接场景或前置节点的有效输出端口");
+            }
+            boolean connected = skill.inputType.equals(sourceType) || (SkillLabV2Catalog.ANY_ARTIFACT.equals(
+                skill.inputType) && "node".equals(input.from));
+            if (!connected) {
+                throw new IllegalArgumentException("节点 " + node.id + " 的输入类型 " + skill.inputType
+                    + " 与绑定端口 " + sourceType + " 不兼容");
+            }
+            String outputType = fixture.skillId.equals(skill.id) && fixture.outputType != null && !fixture.outputType.isEmpty()
+                ? fixture.outputType : skill.outputType;
+            outputs.put(node.id, SkillLabV2Catalog.SAME_AS_INPUT.equals(outputType) ? sourceType : outputType);
+        }
+        return outputs;
+    }
+
+    private Path requireFile(Path root, String relative) throws IOException {
+        Path file = SkillLabV2Catalog.inside(root, relative);
+        if (!Files.isRegularFile(file)) {
+            throw new IllegalArgumentException("Skill 目录声明的文件不存在 " + relative);
+        }
+        return file;
+    }
+
+    private String displayPath(Path root, Path item) {
+        return root.relativize(item).toString().replace('\\', '/');
+    }
+
+    @ExceptionHandler(HttpMessageNotReadableException.class)
+    ResponseEntity<ObjectNode> malformed(HttpMessageNotReadableException error) {
+        return problem(HttpStatus.BAD_REQUEST, "请求须使用有效的 JSON 和端口结构");
+    }
+
+    @ExceptionHandler(IllegalArgumentException.class)
+    ResponseEntity<ObjectNode> badRequest(IllegalArgumentException error) {
+        return problem(HttpStatus.BAD_REQUEST, error.getMessage());
+    }
+
+    @ExceptionHandler(IllegalStateException.class)
+    ResponseEntity<ObjectNode> conflict(IllegalStateException error) {
+        return problem(HttpStatus.CONFLICT, error.getMessage());
+    }
+
+    @ExceptionHandler(IOException.class)
+    ResponseEntity<ObjectNode> directoryError(IOException error) {
+        return problem(HttpStatus.SERVICE_UNAVAILABLE, error.getMessage());
+    }
+
+    @ExceptionHandler(Exception.class)
+    ResponseEntity<ObjectNode> serviceError(Exception error) {
+        log.error("Skill Lab v2 request failed", error);
+        return problem(HttpStatus.INTERNAL_SERVER_ERROR, "课程后端未能完成请求");
+    }
+
+    private ResponseEntity<ObjectNode> problem(HttpStatus status, String message) {
+        return ResponseEntity.status(status).body(json.createObjectNode().put("error", message));
+    }
+
+    public static class RegistryAction {
+        public String action;
+    }
+
+    public static class Workflow {
+        public String dataset;
+        public String caseId;
+        public List<Node> nodes;
+    }
+
+    public static class Node {
+        public String id;
+        public String skillId;
+        public Input input;
+    }
+
+    public static class Input {
+        public String from;
+        public String nodeId;
+        public String port;
+    }
+
+    public static class Run {
+        public String id;
+        public String status;
+        public String directory;
+        public Workflow workflow;
+        public final List<NodeResult> nodes = new ArrayList<>();
+    }
+
+    public static class NodeResult {
+        public String id;
+        public String skillId;
+        public String status;
+        public long elapsedMs;
+        public String flowId;
+        public int generation;
+        public String inputDirectory;
+        public String outputType;
+        public String outputDirectory;
+        public List<SkillLabV2Runner.Artifact> artifacts = Collections.emptyList();
+        public String error;
+    }
+}
