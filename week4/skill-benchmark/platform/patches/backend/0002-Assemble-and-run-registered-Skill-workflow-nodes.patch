+package com.horsecoder.skilllab.liutianyu;
+
+import cc.eamon.open.flow.config.flow.FlowConfig;
+import cc.eamon.open.flow.config.flow.FlowNodeConfig;
+import cc.eamon.open.flow.config.flow.FlowRouteConfig;
+import cc.eamon.open.flow.config.flow.node.FlowParamConfig;
+import cc.eamon.open.flow.config.flow.node.FlowResultConfig;
+import cc.eamon.open.flow.core.FlowEngine;
+import cc.eamon.open.flow.core.context.FlowContextHolder;
+import cc.eamon.open.flow.core.context.Initializer;
+import cc.eamon.open.flow.core.context.InitializerEnums;
+import cc.eamon.open.flow.core.stereotype.Flow;
+import cc.eamon.open.flow.core.stereotype.execute.holder.FlowHolder;
+import cc.eamon.open.flow.core.stereotype.support.route.ExecutorHolder;
+import cc.eamon.open.flow.remote.FlowRequest;
+import cc.eamon.open.flow.spring.FlowComponent;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.horsecoder.common.whuTalent.core.flow.FlowEngineService;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.UUID;
+
+@FlowComponent
+public class SkillLabV2Engine {
+    private static final String DISPATCH = "LIUTIANYU_V2_DISPATCH";
+    private static final String DISABLED = "LIUTIANYU_V2_DISABLED";
+    private final Map<String, Integer> generations = new LinkedHashMap<>();
+    private final String session = UUID.randomUUID().toString();
+    private final FlowEngineService flows;
+    private final SkillLabV2Runner runner;
+    private final ObjectMapper json;
+
+    public SkillLabV2Engine(FlowEngineService flows, SkillLabV2Runner runner, ObjectMapper json) {
+        this.flows = flows;
+        this.runner = runner;
+        this.json = json;
+    }
+
+    synchronized Map<String, Registration> registrations(Iterable<String> ids) {
+        Map<String, Registration> states = new LinkedHashMap<>();
+        for (String id : ids) {
+            states.put(id, registration(id));
+        }
+        return states;
+    }
+
+    synchronized Registration change(String id, boolean enabled) throws Exception {
+        // 首次使用时初始化课程应用装配的 Spring FlowComponent。
+        FlowEngine.instance().release();
+        Initializer initializer = InitializerEnums.DEFAULT.getInitializer();
+        String flowId = flowId(id);
+        FlowHolder previous = initializer.getFlowHolder(flowId);
+        FlowConfig config = configuration(flowId, enabled ? DISPATCH : DISABLED);
+        FlowHolder holder = new FlowHolder(config);
+        initializer.addExtraFlowConfig(Collections.singletonMap(flowId, config));
+        initializer.addExtraFlowHolder(Collections.singletonMap(flowId, holder));
+        if (previous != null) {
+            previous.getFlowConfig().getNodes().forEach(initializer.getFlowNodeConfigFlowConfigs()::remove);
+        }
+        generations.merge(id, 1, Integer::sum);
+        return registration(id);
+    }
+
+    // 同一注册槽执行期间保持 holder 和节点配置一致。
+    synchronized SkillLabV2Runner.Result execute(String id, SkillLabV2Runner.Invocation invocation) throws Exception {
+        Registration current = registration(id);
+        if (!current.loaded) {
+            throw new IllegalStateException("Skill 已撤销或尚未装配 " + id);
+        }
+        FlowRequest request = new FlowRequest();
+        request.setFlowId(flowId(id));
+        request.setParams(Collections.singletonMap("payload", json.writeValueAsString(invocation)));
+        try {
+            Object result = flows.runFlowByFlowId(request).get("result");
+            if (!(result instanceof String)) {
+                throw new IllegalStateException("rsi-flow 未返回节点结果");
+            }
+            SkillLabV2Runner.Result details = json.readValue((String) result, SkillLabV2Runner.Result.class);
+            details.flowId = current.flowId;
+            details.generation = current.generation;
+            return details;
+        } finally {
+            FlowContextHolder.clear();
+            ExecutorHolder.clear();
+        }
+    }
+
+    @Flow(DISPATCH)
+    public void dispatch(String payload) throws Exception {
+        SkillLabV2Runner.Invocation invocation = json.readValue(payload, SkillLabV2Runner.Invocation.class);
+        FlowEngine.instance().register("result", json.writeValueAsString(runner.execute(invocation)));
+    }
+
+    @Flow(DISABLED)
+    public void disabled(String payload) {
+        FlowEngine.instance().register("result", "{\"error\":\"Skill 已撤销\"}");
+    }
+
+    private Registration registration(String id) {
+        String flowId = flowId(id);
+        FlowHolder holder = InitializerEnums.DEFAULT.getInitializer().getFlowHolder(flowId);
+        boolean loaded = holder != null && DISPATCH.equals(holder.getFlowConfig().getNodes().get(0).getReference());
+        return new Registration(loaded, generations.getOrDefault(id, 0), flowId, session);
+    }
+
+    private static String flowId(String id) {
+        return "@com.horsecoder.skilllab.liutianyu/v2/" + id;
+    }
+
+    private FlowConfig configuration(String id, String reference) {
+        FlowParamConfig payload = new FlowParamConfig();
+        payload.setName("payload");
+        payload.setType("String");
+        payload.setNotnull(true);
+        FlowResultConfig result = new FlowResultConfig();
+        result.setName("result");
+        result.setType("String");
+        result.setNotnull(true);
+
+        FlowNodeConfig node = new FlowNodeConfig();
+        node.setId("dispatch");
+        node.setType("event");
+        node.setReference(reference);
+        node.setParams(Collections.singletonList(payload));
+        node.setResults(Collections.singletonList(result));
+
+        FlowConfig config = new FlowConfig();
+        config.setId(id);
+        config.setName(id.substring(id.lastIndexOf('/') + 1));
+        config.setType("flow");
+        config.setParams(Collections.singletonList(payload));
+        config.setResults(Collections.singletonList(result));
+        config.setNodes(Collections.singletonList(node));
+        config.setRoutes(Arrays.asList(route("start", "dispatch"), route("dispatch", "end")));
+        return config;
+    }
+
+    private FlowRouteConfig route(String from, String to) {
+        FlowRouteConfig route = new FlowRouteConfig();
+        route.setSource(from);
+        route.setTarget(to);
+        return route;
+    }
+
+    public static class Registration {
+        public final boolean loaded;
+        public final int generation;
+        public final String flowId;
+        public final String session;
+
+        Registration(boolean loaded, int generation, String flowId, String session) {
+            this.loaded = loaded;
+            this.generation = generation;
+            this.flowId = flowId;
+            this.session = session;
+        }
+    }
+}
