+package com.horsecoder.skilllab.liutianyu;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+import org.springframework.beans.factory.annotation.Value;
+
+public class SkillLabV2Runner {
+    private static final int MAX_ENTRIES = 4096;
+    private final ObjectMapper json;
+    private final String python;
+    private final String distro;
+
+    public SkillLabV2Runner(ObjectMapper json, @Value("${liutianyu.v2.python:}") String python,
+            @Value("${liutianyu.v2.wsl-distro:Ubuntu}") String distro) {
+        this.json = json;
+        this.python = python;
+        this.distro = distro;
+    }
+
+    Result execute(Invocation invocation) {
+        Result result = new Result();
+        try {
+            Path input = Paths.get(invocation.input);
+            Path output = Paths.get(invocation.output);
+            Path step = output.getParent();
+            if (SkillLabV2Catalog.VERIFY.equals(invocation.skillId)) {
+                Path expected = input.resolve(SkillLabV2Catalog.relativePath(invocation.expected));
+                if ((!Files.isDirectory(expected) && !Files.isRegularFile(expected))
+                        || !expected.toRealPath().startsWith(input)) {
+                    throw new IOException("缺少预期产物 " + invocation.expected);
+                }
+                if (Files.isDirectory(expected) && inventory(expected).isEmpty()) {
+                    throw new IOException("预期产物目录为空 " + invocation.expected);
+                }
+                output = input;
+            } else if (SkillLabV2Catalog.MANIFEST.equals(invocation.skillId)) {
+                Files.createDirectory(output);
+                json.writerWithDefaultPrettyPrinter().writeValue(output.resolve("manifest.json").toFile(), inventory(input));
+            } else {
+                Files.createDirectory(output);
+                Path copiedInput = Files.createDirectory(step.resolve("input"));
+                copyInput(input, copiedInput);
+                runPython(invocation, copiedInput, output, step.resolve("process.log"));
+            }
+            result.artifacts = inventory(output);
+            if (result.artifacts.isEmpty()) {
+                throw new IOException("节点未生成可传递的文件");
+            }
+            result.directory = output.toString();
+        } catch (InterruptedException error) {
+            Thread.currentThread().interrupt();
+            result.error = "Skill 进程执行被中断";
+        } catch (Exception error) {
+            result.error = error.getMessage() == null ? error.getClass().getSimpleName() : error.getMessage();
+        }
+        return result;
+    }
+
+    private void runPython(Invocation invocation, Path input, Path output, Path log)
+            throws IOException, InterruptedException {
+        if (python.isEmpty()) {
+            throw new IOException("请通过 LIUTIANYU_V2_PYTHON 设置课程 Python 解释器");
+        }
+        boolean wsl = "\\".equals(java.io.File.separator) && python.startsWith("/");
+        Path script = Paths.get(invocation.script);
+        List<String> command = new ArrayList<>();
+        if (wsl) {
+            command.addAll(Arrays.asList("wsl.exe", "-d", distro, "--exec", "timeout", "--kill-after=5s", "110s"));
+        }
+        command.addAll(Arrays.asList(python, "-B", processPath(script, wsl), invocation.argument,
+            processPath(input, wsl), processPath(output, wsl)));
+        Process process = new ProcessBuilder(command).directory(output.getParent().toFile())
+            .redirectErrorStream(true).redirectOutput(log.toFile()).start();
+        try {
+            process.getOutputStream().close();
+            if (!process.waitFor(120, TimeUnit.SECONDS)) {
+                throw new IOException("Skill 进程执行超时");
+            }
+            if (process.exitValue() != 0) {
+                byte[] prefix = new byte[8192];
+                String details = "";
+                try (InputStream logInput = Files.newInputStream(log)) {
+                    int length = logInput.read(prefix);
+                    if (length > 0) {
+                        details = new String(prefix, 0, length, StandardCharsets.UTF_8).trim();
+                    }
+                }
+                throw new IOException("Skill 进程退出，状态 " + process.exitValue() + (details.isEmpty() ? "" : "\n" + details));
+            }
+        } finally {
+            if (process.isAlive()) {
+                process.destroyForcibly();
+            }
+        }
+    }
+
+    private String processPath(Path path, boolean wsl) {
+        String value = path.toAbsolutePath().toString();
+        if (!wsl) {
+            return value;
+        }
+        if (value.length() < 3 || value.charAt(1) != ':') {
+            throw new IllegalArgumentException("WSL 运行需要 Windows 本地盘符路径");
+        }
+        return "/mnt/" + Character.toLowerCase(value.charAt(0)) + value.substring(2).replace('\\', '/');
+    }
+
+    private void copyInput(Path source, Path destination) throws IOException {
+        for (Path entry : entries(source)) {
+            Path selected = destination.resolve(source.relativize(entry));
+            if (Files.isDirectory(entry, LinkOption.NOFOLLOW_LINKS)) {
+                Files.createDirectories(selected);
+            } else if (Files.isRegularFile(entry, LinkOption.NOFOLLOW_LINKS)) {
+                Files.createDirectories(selected.getParent());
+                Files.copy(entry, selected);
+            } else {
+                throw new IOException("输入目录包含链接或特殊文件 " + source.relativize(entry));
+            }
+        }
+    }
+
+    private List<Path> entries(Path directory) throws IOException {
+        if (!Files.isDirectory(directory, LinkOption.NOFOLLOW_LINKS)) {
+            throw new IOException("节点需要有效的目录输入");
+        }
+        try (Stream<Path> entries = Files.walk(directory)) {
+            List<Path> paths = entries.limit(MAX_ENTRIES + 1L).collect(Collectors.toList());
+            if (paths.size() > MAX_ENTRIES) {
+                throw new IOException("目录的文件和子目录超过 " + MAX_ENTRIES + " 项");
+            }
+            paths.sort(Path::compareTo);
+            return paths;
+        }
+    }
+
+    private List<Artifact> inventory(Path directory) throws IOException, NoSuchAlgorithmException {
+        List<Artifact> artifacts = new ArrayList<>();
+        for (Path entry : entries(directory)) {
+            if (Files.isDirectory(entry, LinkOption.NOFOLLOW_LINKS)) {
+                continue;
+            }
+            if (!Files.isRegularFile(entry, LinkOption.NOFOLLOW_LINKS)) {
+                throw new IOException("产物目录包含链接或特殊文件 " + directory.relativize(entry));
+            }
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            byte[] buffer = new byte[65536];
+            long bytes = 0;
+            try (InputStream input = Files.newInputStream(entry)) {
+                int count;
+                while ((count = input.read(buffer)) != -1) {
+                    digest.update(buffer, 0, count);
+                    bytes += count;
+                }
+            }
+            StringBuilder hex = new StringBuilder();
+            for (byte value : digest.digest()) {
+                hex.append(Character.forDigit((value >>> 4) & 15, 16));
+                hex.append(Character.forDigit(value & 15, 16));
+            }
+            Artifact artifact = new Artifact();
+            artifact.path = directory.relativize(entry).toString().replace('\\', '/');
+            artifact.bytes = bytes;
+            artifact.sha256 = hex.toString();
+            artifacts.add(artifact);
+        }
+        return artifacts;
+    }
+
+    public static class Invocation {
+        public String skillId;
+        public String script;
+        public String argument;
+        public String expected;
+        public String input;
+        public String output;
+    }
+
+    public static class Result {
+        public String directory;
+        public String flowId;
+        public int generation;
+        public String error;
+        public List<Artifact> artifacts;
+    }
+
+    public static class Artifact {
+        public String path;
+        public long bytes;
+        public String sha256;
+    }
+}
