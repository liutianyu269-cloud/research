+package com.horsecoder.skilllab.liutianyu;
+
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.springframework.beans.factory.annotation.Value;
+
+public class SkillLabV2Catalog {
+    static final String VERIFY = "verify-expected-artifact";
+    static final String MANIFEST = "write-artifact-manifest";
+    static final String ANY_ARTIFACT = "*";
+    static final String SAME_AS_INPUT = "$input";
+    private static final List<String> DATASETS = Arrays.asList("skillgenbench", "gittaskbench");
+    private final String workspace;
+    private final ObjectMapper json;
+
+    public SkillLabV2Catalog(@Value("${liutianyu.v2.workspace:}") String workspace, ObjectMapper json) {
+        this.workspace = workspace;
+        this.json = json;
+    }
+
+    Path root() throws IOException {
+        if (workspace.isEmpty()) {
+            throw new IOException("请通过 LIUTIANYU_V2_WORKSPACE 设置 v2 课程工作区");
+        }
+        return Paths.get(workspace).toRealPath();
+    }
+
+    Snapshot read() throws IOException {
+        Path root = root();
+        Snapshot catalog = new Snapshot();
+        for (String datasetName : DATASETS) {
+            Path relative = Paths.get("work", "skill-lab-v2", datasetName, "catalog.json");
+            if (!Files.isRegularFile(root.resolve(relative))) {
+                continue;
+            }
+            Dataset dataset = json.readValue(inside(root, relative.toString()).toFile(), Dataset.class);
+            if (!datasetName.equalsIgnoreCase(dataset.dataset) || dataset.skills == null || dataset.cases == null) {
+                throw new IOException("无效的课程目录 " + datasetName);
+            }
+            Map<String, Skill> datasetSkills = new LinkedHashMap<>();
+            for (Skill skill : dataset.skills) {
+                if (skill == null || !isId(skill.id) || isBlank(skill.title) || isBlank(skill.inputType)
+                        || isBlank(skill.outputType) || skill.inputType.equals(ANY_ARTIFACT)
+                        || skill.outputType.equals(SAME_AS_INPUT) || isBlank(skill.script) || isBlank(skill.skillFile)
+                        || catalog.skills.putIfAbsent(skill.id, skill) != null) {
+                    throw new IOException("无效或重复的 Skill 记录 " + datasetName);
+                }
+                relativePath(skill.script);
+                relativePath(skill.skillFile);
+                datasetSkills.put(skill.id, skill);
+            }
+            Map<String, Fixture> fixtures = new LinkedHashMap<>();
+            for (Fixture fixture : dataset.cases) {
+                if (fixture == null || !isId(fixture.id) || isBlank(fixture.title)
+                        || !datasetSkills.containsKey(fixture.skillId) || isBlank(fixture.skillArgument)
+                        || fixtures.putIfAbsent(fixture.id, fixture) != null) {
+                    throw new IOException("无效或重复的回归场景 " + datasetName);
+                }
+                relativePath(fixture.inputRoot);
+                relativePath(fixture.expectedOutput);
+            }
+            dataset.dataset = datasetName;
+            catalog.datasets.add(dataset);
+        }
+        addInternal(catalog, VERIFY, "检查预期产物", "检查本场景要求的路径并继续传递产物目录。", SAME_AS_INPUT);
+        addInternal(catalog, MANIFEST, "生成产物清单", "读取上游产物并记录文件相对路径、大小与 SHA-256。", "artifact-manifest/json");
+        return catalog;
+    }
+
+    private void addInternal(Snapshot catalog, String id, String title, String description, String outputType)
+            throws IOException {
+        Skill skill = new Skill();
+        skill.id = id;
+        skill.title = title;
+        skill.description = description;
+        skill.source = "课程平台内置工具";
+        skill.inputType = ANY_ARTIFACT;
+        skill.outputType = outputType;
+        if (catalog.skills.putIfAbsent(id, skill) != null) {
+            throw new IOException("目录与平台内置 Skill 的 ID 冲突 " + id);
+        }
+    }
+
+    static boolean isId(String value) {
+        return value != null && value.matches("[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}");
+    }
+
+    private static boolean isBlank(String value) {
+        return value == null || value.trim().isEmpty();
+    }
+
+    static Path relativePath(String value) {
+        if (isBlank(value)) {
+            throw new IllegalArgumentException("目录记录缺少路径");
+        }
+        Path path = Paths.get(value);
+        if (path.isAbsolute() || path.getRoot() != null || path.normalize().startsWith("..")
+                || path.normalize().toString().isEmpty()) {
+            throw new IllegalArgumentException("目录记录包含无效的相对路径");
+        }
+        return path.normalize();
+    }
+
+    static Path inside(Path root, String relative) throws IOException {
+        Path path = root.resolve(relativePath(relative)).toRealPath();
+        if (!path.startsWith(root)) {
+            throw new IllegalArgumentException("目录指向课程工作区之外");
+        }
+        return path;
+    }
+
+    public static class Snapshot {
+        public final List<Dataset> datasets = new ArrayList<>();
+        public final Map<String, Skill> skills = new LinkedHashMap<>();
+    }
+
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    public static class Dataset {
+        public String dataset;
+        public List<Fixture> cases;
+        public List<Skill> skills;
+    }
+
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    public static class Fixture {
+        public String id;
+        public String title;
+        public String inputRoot;
+        public String expectedOutput;
+        public String skillId;
+        public String skillArgument;
+        public String outputType;
+    }
+
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    public static class Skill {
+        public String id;
+        public String title;
+        public String description;
+        public String source;
+        public String script;
+        public String skillFile;
+        public String inputType;
+        public String outputType;
+    }
+}
